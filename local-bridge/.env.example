# =========================================================
#  OZEL Cafe — Local Bridge Server v2.0 — Environment
# =========================================================

# ─── Pusher (نفس بيانات ملف .env الرئيسي) ─────────────────
PUSHER_KEY=d7010f3c5b8b98295a04
PUSHER_CLUSTER=eu

# ─── الطابعة الحرارية ──────────────────────────────────────
# عنوان IP الطابعة على الشبكة المحلية (اتركه فارغاً لتخطي الطباعة)
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100
# نوع الطابعة: EPSON أو STAR
PRINTER_TYPE=EPSON

# ─── إعدادات السيرفر المحلي ────────────────────────────────
BRIDGE_PORT=3001

# ─── مزامنة مع Vercel (اختياري) ───────────────────────────
# رابط موقع Vercel (بدون / في النهاية)
# اتركه كما هو إذا لم تريد المزامنة
VERCEL_API_URL=https://your-project.vercel.app

# JWT Token لحساب الكاشير - احصل عليه من المتصفح:
#   1. سجّل دخول الكاشير على الموقع
#   2. افتح DevTools (F12) → Console
#   3. اكتب: localStorage.getItem('ozel_token')
#   4. انسخ القيمة هنا
CASHIER_JWT_TOKEN=
BRIDGE_API_KEY=ozel_cafe_bridge_secret_2026_xyz
