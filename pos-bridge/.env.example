# Bridge server port
BRIDGE_PORT=5001

# Must match BRIDGE_API_KEY set on Vercel (OZEL Cafe project env variables)
BRIDGE_API_KEY=ozel-bridge-secret

# POS PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pos_system
PG_USER=postgres
PG_PASSWORD=MproM7*#

# Vercel site URL (for polling — no ngrok needed)
# Set this to your Vercel live URL so the bridge can poll for unsynced orders
VERCEL_BRIDGE_URL=https://ozel-weld.vercel.app
